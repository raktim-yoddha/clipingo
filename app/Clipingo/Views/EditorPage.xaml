<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Clipingo.Models"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title and the video being edited.  -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Editor" />
                <TextBlock Style="{StaticResource DescriptionText}" Text="Trim a clip, fix its title and captions, then export it again. Each export includes a Premiere Pro timeline." />
            </StackPanel>
            <ComboBox
                Grid.Column="1"
                Width="360"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Video"
                Header="Video"
                ItemsSource="{x:Bind ViewModel.Runs}"
                PlaceholderText="Choose a video"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=OneWay}"
                SelectionChanged="Run_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RunListing">
                        <TextBlock
                            Text="{x:Bind Source.Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Clips of the video.  -->
            <Border Padding="8" Style="{StaticResource PanelBorder}">
                <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Padding="8,4,4,0"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        AutomationProperties.Name="New clip at playhead"
                        Command="{x:Bind ViewModel.NewClipCommand}"
                        Style="{StaticResource GhostButton}"
                        ToolTipService.ToolTip="Mark a new clip from the playhead (N)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock Text="New clip" />
                        </StackPanel>
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete clip"
                        Click="DeleteClip_Click"
                        IsEnabled="{x:Bind ViewModel.HasClip, Mode=OneWay}"
                        Style="{StaticResource GhostButton}"
                        ToolTipService.ToolTip="Remove this clip from the video's list">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                            <TextBlock Text="Delete" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ListView
                    Grid.Row="1"
                    AutomationProperties.Name="Clips"
                    ItemsSource="{x:Bind ViewModel.Clips}"
                    SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                    SelectionChanged="Clip_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:EditorClip">
                            <StackPanel
                                Padding="4,10"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Spacing="2">
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource HintText}" Text="{x:Bind RangeText, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource HintText}" Text="{x:Bind StateText, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                </Grid>
            </Border>

            <!--  Nothing open yet.  -->
            <Border
                Grid.Column="1"
                Padding="32,56"
                VerticalAlignment="Top"
                Style="{StaticResource PanelBorder}"
                Visibility="{x:Bind ViewModel.NoClip, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon
                        FontSize="26"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE70F;" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No clip open" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource HintText}"
                        Text="Choose a video above, or press Edit on a clip in Jobs or Library." />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Visibility="{x:Bind ViewModel.HasClip, Mode=OneWay}">
                <StackPanel Padding="0,0,16,24" Spacing="24">
                    <InfoBar
                        IsClosable="True"
                        IsOpen="{x:Bind views:Format.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                        Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        Severity="Error" />

                    <!--  Preview  -->
                    <Border Padding="16" Style="{StaticResource PanelBorder}">
                        <StackPanel Spacing="16">
                            <Grid>
                                <SelectorBar x:Name="PreviewBar" SelectionChanged="PreviewBar_SelectionChanged">
                                    <SelectorBarItem
                                        x:Name="SourceTab"
                                        AutomationProperties.Name="Preview source"
                                        IsSelected="True"
                                        Text="Source" />
                                    <SelectorBarItem
                                        x:Name="ExportTab"
                                        AutomationProperties.Name="Preview export"
                                        Text="Exported clip" />
                                </SelectorBar>
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <ComboBox
                                        x:Name="PreviewSpeed"
                                        MinWidth="88"
                                        AutomationProperties.Name="Preview speed"
                                        SelectedIndex="1"
                                        SelectionChanged="PreviewSpeed_SelectionChanged"
                                        ToolTipService.ToolTip="Preview speed (does not change the export)">
                                        <x:String>0.5×</x:String>
                                        <x:String>1×</x:String>
                                        <x:String>1.5×</x:String>
                                        <x:String>2×</x:String>
                                    </ComboBox>
                                    <Button AutomationProperties.Name="Play clip" Click="PlayClip_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE768;" />
                                            <TextBlock Text="Play clip" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border
                                Height="360"
                                Background="Black"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <MediaPlayerElement
                                    x:Name="Player"
                                    AreTransportControlsEnabled="True"
                                    AutomationProperties.Name="Preview player"
                                    Stretch="Uniform" />
                            </Border>
                            <TextBlock
                                Style="{StaticResource HintText}"
                                Text="No export yet. Press Export clip to render it."
                                Visibility="{x:Bind views:Format.Lacks(ViewModel.ExportedVideo), Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Trim  -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource SectionHeaderText}"
                                Text="Trim" />
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                                <TextBlock
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource HintText}">
                                    <Run Text="Playhead" />
                                    <Run Text="{x:Bind ViewModel.PositionText, Mode=OneWay}" />
                                </TextBlock>
                                <Button
                                    AutomationProperties.Name="Undo trim"
                                    Command="{x:Bind ViewModel.UndoTrimCommand}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ToolTip="Undo trim (Ctrl+Z)">
                                    <FontIcon FontSize="14" Glyph="&#xE7A7;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="Redo trim"
                                    Command="{x:Bind ViewModel.RedoTrimCommand}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ToolTip="Redo trim (Ctrl+Y)">
                                    <FontIcon FontSize="14" Glyph="&#xE7A6;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Padding="20,16" Style="{StaticResource SettingRowBorder}">
                            <StackPanel Spacing="12">
                                <!--  The clip's part of the timeline (accent band) under the playhead slider.  -->
                                <Grid Height="32">
                                    <Grid
                                        Height="8"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                        CornerRadius="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{x:Bind views:Format.Stars(ViewModel.BeforeStars), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind views:Format.Stars(ViewModel.InsideStars), Mode=OneWay}" />
                                            <ColumnDefinition Width="{x:Bind views:Format.Stars(ViewModel.AfterStars), Mode=OneWay}" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="1"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" />
                                    </Grid>
                                    <Slider
                                        x:Name="Timeline"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Playhead"
                                        IsThumbToolTipEnabled="False"
                                        Maximum="{x:Bind ViewModel.WinEnd, Mode=OneWay}"
                                        Minimum="{x:Bind ViewModel.WinStart, Mode=OneWay}"
                                        Opacity="0.9"
                                        StepFrequency="0.1"
                                        ValueChanged="Timeline_ValueChanged" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource HintText}" Text="Start" />
                                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.StartText, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                AutomationProperties.Name="Start 1 second earlier"
                                                Command="{x:Bind ViewModel.NudgeStartCommand}"
                                                CommandParameter="-1"
                                                Content="−1s" />
                                            <Button
                                                AutomationProperties.Name="Start 1 second later"
                                                Command="{x:Bind ViewModel.NudgeStartCommand}"
                                                CommandParameter="1"
                                                Content="+1s" />
                                            <Button
                                                AutomationProperties.Name="Set start to playhead"
                                                Command="{x:Bind ViewModel.SetStartCommand}"
                                                Content="Set to playhead" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource HintText}"
                                            Text="Length" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            Text="{x:Bind ViewModel.LengthText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource HintText}"
                                            Text="End" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                            Text="{x:Bind ViewModel.EndText, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Button
                                                AutomationProperties.Name="Set end to playhead"
                                                Command="{x:Bind ViewModel.SetEndCommand}"
                                                Content="Set to playhead" />
                                            <Button
                                                AutomationProperties.Name="End 1 second earlier"
                                                Command="{x:Bind ViewModel.NudgeEndCommand}"
                                                CommandParameter="-1"
                                                Content="−1s" />
                                            <Button
                                                AutomationProperties.Name="End 1 second later"
                                                Command="{x:Bind ViewModel.NudgeEndCommand}"
                                                CommandParameter="1"
                                                Content="+1s" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Transcript: click a word to move the playhead there.  -->
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock Style="{StaticResource SectionHeaderText}" Text="Transcript" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{StaticResource HintText}"
                                Text="Click a word to jump there" />
                        </Grid>
                        <Border Padding="20,16" Style="{StaticResource SettingRowBorder}">
                            <RichTextBlock
                                x:Name="Transcript"
                                AutomationProperties.Name="Transcript"
                                IsTextSelectionEnabled="False"
                                LineHeight="26" />
                        </Border>
                    </StackPanel>

                    <!--  Text  -->
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Title and captions" />
                        <TextBox
                            AutomationProperties.Name="Clip title"
                            Header="Title"
                            MaxLength="120"
                            Text="{x:Bind ViewModel.ClipTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            MinHeight="120"
                            AcceptsReturn="True"
                            AutomationProperties.Name="Caption text"
                            Header="Caption text"
                            Text="{x:Bind ViewModel.CaptionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource HintText}" Text="Fix misheard words here. Word timing is kept; added or removed words share the original timing." />
                    </StackPanel>

                    <!--  Export  -->
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeaderText}" Text="Export" />
                        <Border Padding="20,16" Style="{StaticResource SettingRowBorder}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Format"
                                        Header="Format"
                                        ItemsSource="{x:Bind vm:EditorViewModel.Formats}"
                                        SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Framing"
                                        Header="Framing"
                                        ItemsSource="{x:Bind vm:EditorViewModel.Framings}"
                                        SelectedIndex="{x:Bind ViewModel.FramingIndex, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Caption style"
                                        Header="Caption style"
                                        ItemsSource="{x:Bind ViewModel.CaptionStyles}"
                                        SelectedIndex="{x:Bind ViewModel.CaptionStyleIndex, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:CaptionPreset">
                                                <TextBlock Text="{x:Bind Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Caption position"
                                        Header="Caption position"
                                        ItemsSource="{x:Bind vm:EditorViewModel.Positions}"
                                        SelectedIndex="{x:Bind ViewModel.CaptionPositionIndex, Mode=TwoWay}" />
                                    <Slider
                                        Grid.Column="1"
                                        AutomationProperties.Name="Caption size"
                                        Header="Caption size (%)"
                                        Maximum="160"
                                        Minimum="60"
                                        StepFrequency="5"
                                        Value="{x:Bind ViewModel.CaptionSize, Mode=TwoWay}" />
                                    <ComboBox
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Export speed"
                                        Header="Speed"
                                        ItemsSource="{x:Bind vm:EditorViewModel.Speeds}"
                                        SelectedIndex="{x:Bind ViewModel.SpeedIndex, Mode=TwoWay}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="24">
                                    <CheckBox
                                        AutomationProperties.Name="Fade in and out"
                                        Content="Fade in and out"
                                        IsChecked="{x:Bind ViewModel.Fade, Mode=TwoWay}" />
                                    <CheckBox
                                        AutomationProperties.Name="Burn in captions"
                                        Content="Captions"
                                        IsChecked="{x:Bind ViewModel.BurnCaptions, Mode=TwoWay}" />
                                    <CheckBox
                                        AutomationProperties.Name="Title at the top"
                                        Content="Title at the top"
                                        IsChecked="{x:Bind ViewModel.ShowTitle, Mode=TwoWay}" />
                                    <CheckBox
                                        AutomationProperties.Name="Cut dead air"
                                        Content="Cut dead air"
                                        IsChecked="{x:Bind ViewModel.CutDeadAir, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource HintText}" Text="Shortcuts: Space play or pause · I / O set start / end · ← / → 1 s · N new clip · Ctrl+Z / Ctrl+Y undo / redo trim · Ctrl+S save · Ctrl+E export" />

                    <!--  Actions  -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource DescriptionText}"
                                Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.Name="Undo changes"
                                Command="{x:Bind ViewModel.RevertCommand}"
                                Content="Undo changes"
                                Style="{StaticResource GhostButton}" />
                            <Button
                                AutomationProperties.Name="Save"
                                Command="{x:Bind ViewModel.SaveCommand}"
                                Content="Save" />
                            <Button
                                AutomationProperties.Name="Export clip"
                                Command="{x:Bind ViewModel.ExportCommand}"
                                Content="Export clip"
                                Style="{StaticResource PillAccentButton}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingRowBorder}" Visibility="{x:Bind views:Format.Has(ViewModel.ExportedVideo), Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingIcon}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Exported files" />
                                <TextBlock
                                    Style="{StaticResource HintText}"
                                    Text="{x:Bind ViewModel.ExportedVideo, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock Style="{StaticResource HintText}" Text="MP4, SRT captions and a Premiere Pro timeline (.xml): in Premiere, File › Import the .xml." />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Show in folder"
                                    Command="{x:Bind ViewModel.RevealVideoCommand}"
                                    Content="Show in folder" />
                                <Button
                                    AutomationProperties.Name="Show Premiere XML"
                                    Command="{x:Bind ViewModel.RevealXmlCommand}"
                                    Content="Show .xml" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

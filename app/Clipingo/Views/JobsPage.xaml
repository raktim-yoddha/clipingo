<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.JobsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Clipingo.Models"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="24">
            <StackPanel Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Jobs" />
                <TextBlock Style="{StaticResource DescriptionText}" Text="Every video you queued this session. Two run at once; the rest wait their turn." />
            </StackPanel>

            <Border
                Padding="32,56"
                Style="{StaticResource PanelBorder}"
                Visibility="{x:Bind views:Format.Not(HasJobs)}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon
                        FontSize="26"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8FD;" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="No jobs yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource HintText}"
                        Text="Generate clips from Create and they show up here." />
                </StackPanel>
            </Border>

            <ItemsControl AutomationProperties.Name="Jobs" ItemsSource="{x:Bind Jobs.Jobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:JobItem">
                        <Border Margin="0,0,0,16" Style="{StaticResource PanelBorder}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            Style="{StaticResource BodyLargeStrongTextBlockStyle}"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Summary}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,4"
                                        VerticalAlignment="Top"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="{StaticResource ControlCornerRadius}">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{x:Bind views:Format.StatusBrush(IsDone, IsFailed), Mode=OneWay}"
                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                    </Border>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="Cancel job"
                                        Command="{x:Bind CancelCommand}"
                                        Content="Cancel"
                                        Style="{StaticResource GhostButton}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                </Grid>

                                <StackPanel Spacing="6" Visibility="{x:Bind IsActive, Mode=OneWay}">
                                    <ProgressBar
                                        IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                        Maximum="100"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource HintText}" Text="{x:Bind StageText, Mode=OneWay}" />
                                </StackPanel>

                                <TextBlock
                                    Style="{StaticResource DescriptionText}"
                                    Text="{x:Bind ResultText, Mode=OneWay}"
                                    Visibility="{x:Bind views:Format.Has(ResultText), Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Visibility="{x:Bind views:Format.Has(ErrorMessage), Mode=OneWay}" />

                                <!--  Review & edit: pick the moments to export.  -->
                                <StackPanel Spacing="12" Visibility="{x:Bind NeedsReview, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource SectionHeaderText}" Text="Moments" />
                                    <ItemsControl AutomationProperties.Name="Clip candidates" ItemsSource="{x:Bind Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CandidateItem">
                                                <Grid
                                                    Margin="0,0,0,4"
                                                    Padding="16,12"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    ColumnSpacing="16"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox
                                                        MinWidth="0"
                                                        AutomationProperties.Name="{x:Bind Title}"
                                                        IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Range}" />
                                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Reasons}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource SubtitleTextBlockStyle}"
                                                            Text="{x:Bind Score}" />
                                                        <TextBlock
                                                            HorizontalAlignment="Center"
                                                            Style="{StaticResource HintText}"
                                                            Text="Score" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        HorizontalAlignment="Right"
                                        AutomationProperties.Name="Render selected clips"
                                        Command="{x:Bind RenderSelectedCommand}"
                                        Content="Export selected"
                                        Style="{StaticResource PillAccentButton}" />
                                </StackPanel>

                                <!--  Exported clips  -->
                                <StackPanel Spacing="12" Visibility="{x:Bind IsDone, Mode=OneWay}">
                                    <ItemsControl AutomationProperties.Name="Rendered clips" ItemsSource="{x:Bind Rendered}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RenderedClip">
                                                <TextBlock Margin="0,4" Style="{StaticResource BodyTextBlockStyle}">
                                                    <Run FontWeight="SemiBold" Text="{x:Bind Title}" />
                                                    <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind views:Format.ClipLine(DurationS, RemovedS, Encoder)}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Open output folder"
                                        Command="{x:Bind OpenFolderCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                                            <TextBlock Text="Open folder" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.CreatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Clipingo.Models"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel MaxWidth="880" Padding="36,24" Spacing="16">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Create" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Choose a video: a local file or a YouTube stream link."
                TextWrapping="Wrap" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    AutomationProperties.Name="Video link or file path"
                    KeyDown="SourceBox_KeyDown"
                    PlaceholderText="https://www.youtube.com/watch?v=… or C:\Videos\stream.mp4"
                    Text="{x:Bind ViewModel.SourceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Browse for a video file"
                    Click="Browse_Click"
                    Content="Browse…" />
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Load video"
                    Command="{x:Bind ViewModel.ProbeCommand}"
                    Content="Load"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.ProbeCommand.IsRunning, Mode=OneWay}" />

            <InfoBar
                Title="Could not load this video"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <!--  Video card  -->
            <Grid
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="16"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="240"
                    Height="135"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <Grid>
                        <FontIcon FontSize="32" Glyph="&#xE714;" />
                        <Image
                            AutomationProperties.Name="Video thumbnail"
                            Source="{x:Bind views:Format.Image(ViewModel.Source.Thumbnail), Mode=OneWay}"
                            Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Source.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.Channel, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.Details, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  Find clips  -->
            <Grid ColumnSpacing="12" Visibility="{x:Bind ViewModel.HasSource, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.Name="Spoken language"
                    Header="Language"
                    ItemsSource="{x:Bind ViewModel.Languages}"
                    SelectedItem="{x:Bind ViewModel.Language, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Transcribed locally. English uses whisper large-v3-turbo, Hinglish Hindi2Hinglish-Apex, Hindi Vaani."
                    TextWrapping="Wrap" />
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Find clips"
                    Command="{x:Bind ViewModel.FindClipsCommand}"
                    Content="Find clips"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>

            <StackPanel Spacing="4" Visibility="{x:Bind views:Format.Has(ViewModel.StageText), Mode=OneWay}">
                <ProgressBar
                    IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.StageText, Mode=OneWay}" />
            </StackPanel>

            <!--  Candidates  -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasRun, Mode=OneWay}">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Moments" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.RunSummary, Mode=OneWay}" />
                <ItemsControl AutomationProperties.Name="Clip candidates" ItemsSource="{x:Bind ViewModel.Candidates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CandidateItem">
                            <Grid
                                Margin="0,4"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                ColumnSpacing="12"
                                CornerRadius="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    AutomationProperties.Name="{x:Bind Title}"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Range}" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Reasons}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{x:Bind Score}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="score" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ToggleSwitch
                        AutomationProperties.Name="Output format"
                        Header="Format"
                        IsOn="{x:Bind ViewModel.Vertical, Mode=TwoWay}"
                        OffContent="Horizontal 16:9"
                        OnContent="Vertical 9:16" />
                    <ToggleSwitch
                        Grid.Column="1"
                        Header="Cut dead air and fillers"
                        IsOn="{x:Bind ViewModel.CutDeadAir, Mode=TwoWay}" />
                    <ToggleSwitch
                        Grid.Column="2"
                        Header="Burn in captions"
                        IsOn="{x:Bind ViewModel.BurnCaptions, Mode=TwoWay}" />
                    <Button
                        Grid.Column="4"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Render selected clips"
                        Command="{x:Bind ViewModel.RenderCommand}"
                        Content="Render selected"
                        Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </StackPanel>

            <!--  Rendered  -->
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRendered, Mode=OneWay}">
                <Grid>
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Rendered" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Open output folder"
                        Command="{x:Bind ViewModel.OpenOutputFolderCommand}"
                        Content="Open folder" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Each clip has an .mp4, an .srt for Premiere captions and an .xml timeline (File → Import in Premiere)."
                    TextWrapping="Wrap" />
                <ItemsControl AutomationProperties.Name="Rendered clips" ItemsSource="{x:Bind ViewModel.Rendered}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RenderedClip">
                            <TextBlock Margin="0,2" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Text="{x:Bind Title}" />
                                <Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind views:Format.ClipLine(DurationS, RemovedS, Encoder)}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

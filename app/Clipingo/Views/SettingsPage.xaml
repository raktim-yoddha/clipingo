<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Clipingo.Models"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent">

    <!--  Windows Settings layout: page title, section headers, one card per row (4 px apart).  -->
    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            Spacing="24">
            <TextBlock
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="System check" />
                <Border Style="{StaticResource SettingRowBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7F4;" Style="{StaticResource SettingIcon}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{x:Bind ViewModel.GpuSummary, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource HintText}" Text="{x:Bind ViewModel.EncoderSummary, Mode=OneWay}" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Run system check again"
                            Command="{x:Bind ViewModel.CheckCommand}"
                            Content="Check again" />
                    </Grid>
                </Border>
                <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.CheckCommand.IsRunning, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="Updates" />
                <Border Style="{StaticResource SettingRowBorder}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon Glyph="&#xE895;" Style="{StaticResource SettingIcon}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Updates.CurrentVersion}" />
                            <TextBlock
                                Style="{StaticResource HintText}"
                                Text="{x:Bind Updates.AvailableText, Mode=OneWay}"
                                Visibility="{x:Bind Updates.IsAvailable, Mode=OneWay}" />
                            <TextBlock
                                AutomationProperties.LiveSetting="Polite"
                                Style="{StaticResource HintText}"
                                Text="{x:Bind Updates.Status, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                AutomationProperties.Name="Check for updates"
                                Command="{x:Bind Updates.CheckCommand}"
                                Content="Check now" />
                            <Button
                                AutomationProperties.Name="Install update"
                                Command="{x:Bind Updates.InstallCommand}"
                                Content="Update now"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind Updates.IsAvailable, Mode=OneWay}" />
                        </StackPanel>
                        <ProgressBar
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Maximum="100"
                            Visibility="{x:Bind Updates.IsBusy, Mode=OneWay}"
                            Value="{x:Bind Updates.Progress, Mode=OneWay}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource SettingRowBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" Style="{StaticResource SettingIcon}" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Check for updates automatically" />
                            <TextBlock Style="{StaticResource HintText}" Text="When Clipingo starts, it looks for a newer release on GitHub and offers to install it." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="2"
                            MinWidth="0"
                            AutomationProperties.Name="Check for updates automatically"
                            IsOn="{x:Bind Updates.AutoCheck, Mode=TwoWay}"
                            OffContent="Off"
                            OnContent="On" />
                    </Grid>
                </Border>
            </StackPanel>

            <InfoBar
                Title="System check failed"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <InfoBar
                Title="GPU encoding is off"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasDriverHint, Mode=OneWay}"
                Message="{x:Bind ViewModel.DriverHint, Mode=OneWay}"
                Severity="Warning" />

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="Downloads" />
                <ItemsControl AutomationProperties.Name="Downloads" ItemsSource="{x:Bind ViewModel.SpeechModels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SpeechModelItem">
                            <Border Margin="0,0,0,4" Style="{StaticResource SettingRowBorder}">
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <FontIcon Glyph="&#xE896;" Style="{StaticResource SettingIcon}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock
                                            Style="{StaticResource HintText}"
                                            Text="{x:Bind Detail}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Style="{StaticResource HintText}"
                                            Text="{x:Bind ErrorMessage, Mode=OneWay}"
                                            Visibility="{x:Bind views:Format.Has(ErrorMessage), Mode=OneWay}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{x:Bind views:Format.InstallName(Label)}"
                                        Command="{x:Bind InstallCommand}"
                                        Content="Install"
                                        Visibility="{x:Bind CanInstall, Mode=OneWay}" />
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Visibility="{x:Bind Installed, Mode=OneWay}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                            Glyph="&#xE73E;" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Text="{x:Bind StateText, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Spacing="4"
                                        Visibility="{x:Bind InstallCommand.IsRunning, Mode=OneWay}">
                                        <ProgressBar
                                            IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                            Maximum="100"
                                            Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind ProgressText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource HintText}" Text="Tools and speech models download here when you need them, into %LOCALAPPDATA%\Clipingo. Speech is transcribed on this computer; no audio leaves it." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="Tools" />
                <ItemsControl AutomationProperties.Name="Tools" ItemsSource="{x:Bind ViewModel.Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ToolStatus">
                            <Border Margin="0,0,0,4" Style="{StaticResource SettingRowBorder}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;"
                                        Style="{StaticResource SettingIcon}"
                                        Visibility="{x:Bind Found}" />
                                    <FontIcon
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        Glyph="&#xE7BA;"
                                        Style="{StaticResource SettingIcon}"
                                        Visibility="{x:Bind views:Format.Not(Found)}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Purpose}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource HintText}"
                                            Text="{x:Bind Version}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind views:Format.ToolState(Found, Required)}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource SectionHeaderText}" Text="Video encoders" />
                <ItemsControl AutomationProperties.Name="Video encoders" ItemsSource="{x:Bind ViewModel.Encoders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EncoderStatus">
                            <Border Margin="0,0,0,4" Style="{StaticResource SettingRowBorder}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Glyph="&#xE73E;"
                                        Style="{StaticResource SettingIcon}"
                                        Visibility="{x:Bind Works}" />
                                    <FontIcon
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Glyph="&#xE711;"
                                        Style="{StaticResource SettingIcon}"
                                        Visibility="{x:Bind views:Format.Not(Works)}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Label}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Name}" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource HintText}"
                                            Text="{x:Bind Error}"
                                            Visibility="{x:Bind views:Format.Has(Error)}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="{x:Bind views:Format.EncoderState(Works)}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource HintText}" Text="Tried top to bottom; the first one that works encodes your clips." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Clipingo.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:Microsoft.UI.Xaml.Media">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Materials. The window is one neutral gray Mica (GrayBackdrop). Panels on it are in-app acrylic, a step lighter.
                Both fall back to solid colours with transparency off or on battery saver.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <media:AcrylicBrush
                        x:Key="GlassBrush"
                        FallbackColor="#383838"
                        TintColor="#3C3C3C"
                        TintLuminosityOpacity="0.8"
                        TintOpacity="0.6" />
                    <media:AcrylicBrush
                        x:Key="GlassBarBrush"
                        FallbackColor="#333333"
                        TintColor="#353535"
                        TintLuminosityOpacity="0.85"
                        TintOpacity="0.66" />
                    <!--  The light catching a glass edge: brighter at the top, as on Windows flyouts.  -->
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#2EFFFFFF" />
                        <GradientStop Offset="0.3" Color="#14FFFFFF" />
                        <GradientStop Offset="1" Color="#0DFFFFFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <media:AcrylicBrush
                        x:Key="GlassBrush"
                        FallbackColor="#FBFBFB"
                        TintColor="#FDFDFD"
                        TintLuminosityOpacity="0.85"
                        TintOpacity="0.6" />
                    <media:AcrylicBrush
                        x:Key="GlassBarBrush"
                        FallbackColor="#F8F8F8"
                        TintColor="#FAFAFA"
                        TintLuminosityOpacity="0.9"
                        TintOpacity="0.68" />
                    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                        <GradientStop Offset="0.3" Color="#1F000000" />
                        <GradientStop Offset="1" Color="#26000000" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="GlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="GlassEdgeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Page layout (WinUI Gallery proportions). Corners stay Windows' own: 4 on controls, 8 on surfaces.  -->
            <Thickness x:Key="PagePadding">36,24,36,36</Thickness>

            <!--  Titles use the Display cut of Segoe UI Variable (the Windows type ramp); Windows 10 falls back to Segoe UI.  -->
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
            <Style
                x:Key="PageTitleText"
                BasedOn="{StaticResource TitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
            </Style>
            <Style
                x:Key="SubtitleText"
                BasedOn="{StaticResource SubtitleTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            </Style>

            <!--  Section header: Body Strong, sentence case.  -->
            <Style
                x:Key="SectionHeaderText"
                BasedOn="{StaticResource BodyStrongTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Margin" Value="1,0,0,4" />
            </Style>
            <!--  Secondary explanation under a heading or control.  -->
            <Style
                x:Key="DescriptionText"
                BasedOn="{StaticResource BodyTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="LineHeight" Value="20" />
            </Style>
            <Style
                x:Key="HintText"
                BasedOn="{StaticResource CaptionTextBlockStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  The wizard's glass panel.  -->
            <Style x:Key="PanelBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="24" />
            </Style>
            <!--  A settings card: icon, title + description, control on the right.  -->
            <Style x:Key="SettingRowBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12,16,12" />
            </Style>
            <Style x:Key="SettingIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Margin" Value="2,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style
                x:Key="GhostButton"
                BasedOn="{StaticResource DefaultButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="12,6" />
            </Style>
            <Style
                x:Key="PillAccentButton"
                BasedOn="{StaticResource AccentButtonStyle}"
                TargetType="Button">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Padding" Value="16,6" />
            </Style>

            <!--
                Selectable card tile: a ToggleButton. Selected = brighter fill and an accent check badge
                (no coloured outline); the toggle state is exposed to UI Automation.
            -->
            <Style x:Key="TileToggle" TargetType="ToggleButton">
                <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid
                                x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.BackgroundTransition>
                                    <BrushTransition Duration="0:0:0.083" />
                                </Grid.BackgroundTransition>
                                <ContentPresenter
                                    x:Name="Content"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Foreground="{TemplateBinding Foreground}" />
                                <Grid
                                    x:Name="Badge"
                                    Width="18"
                                    Height="18"
                                    Margin="0,9,9,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed">
                                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <FontIcon
                                        FontSize="10"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Glyph="&#xE73E;" />
                                </Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                <Setter Target="Content.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                                <Setter Target="Badge.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
                                                <Setter Target="Badge.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                                <Setter Target="Badge.Visibility" Value="Visible" />
                                                <Setter Target="Content.Opacity" Value="0.8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
                                                <Setter Target="Badge.Visibility" Value="Visible" />
                                                <Setter Target="Root.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Clipingo.Models"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent"
    KeyDown="Page_KeyDown">

    <Page.Resources>
        <!--  Square icon button for toolbars.  -->
        <Style
            x:Key="ToolButton"
            BasedOn="{StaticResource GhostButton}"
            TargetType="Button">
            <Setter Property="Padding" Value="8" />
            <Setter Property="MinWidth" Value="36" />
        </Style>
        <Style x:Key="PaneBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource GlassBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        </Style>
    </Page.Resources>

    <Grid Padding="16,8,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top bar: video, then status and Export.  -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                Width="320"
                VerticalAlignment="Center"
                AutomationProperties.Name="Video"
                ItemsSource="{x:Bind ViewModel.Runs}"
                PlaceholderText="Choose a video"
                SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=OneWay}"
                SelectionChanged="Run_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RunListing">
                        <TextBlock
                            Text="{x:Bind Source.Title}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <ProgressBar
                    Width="120"
                    Maximum="100"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" />
                <TextBlock
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Style="{StaticResource HintText}"
                    Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Show in folder"
                    Command="{x:Bind ViewModel.RevealCommand}"
                    IsEnabled="{x:Bind ViewModel.HasClip, Mode=OneWay}"
                    Style="{StaticResource ToolButton}"
                    ToolTipService.ToolTip="Show the exported files in File Explorer (MP4, SRT and a Premiere Pro .xml)">
                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                </Button>
                <Button
                    AutomationProperties.Name="Export clip"
                    Command="{x:Bind ViewModel.ExportCommand}"
                    IsEnabled="{x:Bind ViewModel.HasClip, Mode=OneWay}"
                    Style="{StaticResource PillAccentButton}"
                    ToolTipService.ToolTip="Render this clip (Ctrl+E)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xEDE1;" />
                        <TextBlock Text="{x:Bind ViewModel.ExportLabel, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind views:Format.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!--  Clips · player · inspector  -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!--  Clips of the video  -->
            <Border Padding="8" Style="{StaticResource PaneBorder}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="8,4,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Clips" />
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="2">
                        <Button
                            AutomationProperties.Name="Delete clip"
                            Click="DeleteClip_Click"
                            IsEnabled="{x:Bind ViewModel.HasClip, Mode=OneWay}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Delete this clip (exported files stay)">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="New clip at playhead"
                            Command="{x:Bind ViewModel.NewClipCommand}"
                            IsEnabled="{x:Bind views:Format.HasText(ViewModel.MediaPath), Mode=OneWay}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="New clip: the marked part (Source), or 30 s from the playhead (N)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                <TextBlock Text="New" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </Grid>
                    <SelectorBar
                        x:Name="ClipFilterBar"
                        Grid.Row="1"
                        SelectionChanged="ClipFilter_SelectionChanged">
                        <SelectorBarItem
                            AutomationProperties.Name="All clips"
                            IsSelected="True"
                            Text="All" />
                        <SelectorBarItem AutomationProperties.Name="Clips exported 9:16" Text="9:16" />
                        <SelectorBarItem AutomationProperties.Name="Clips exported 16:9" Text="16:9" />
                    </SelectorBar>
                    <ListView
                        x:Name="ClipList"
                        Grid.Row="2"
                        AutomationProperties.Name="Clips"
                        ItemsSource="{x:Bind ViewModel.VisibleClips}"
                        SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}"
                        SelectionChanged="Clip_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorClip">
                                <Grid AutomationProperties.Name="{x:Bind Title, Mode=OneWay}" RowSpacing="6">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Click="DeleteClip_Click"
                                                Tag="{x:Bind}"
                                                Text="Delete clip">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Height="45"
                                            VerticalAlignment="Top"
                                            Background="Black"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind views:Format.File(Thumb), Mode=OneWay}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock
                                                MaxLines="2"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Info, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                    <!--  Its exports, each playable here.  -->
                                    <StackPanel
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Padding="8,2"
                                            AutomationProperties.Name="{x:Bind views:Format.TileName('Play 9:16 export of', Title), Mode=OneWay}"
                                            Click="PlayVertical_Click"
                                            FontSize="12"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Play the exported 9:16 clip"
                                            Visibility="{x:Bind HasVertical, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                <TextBlock Text="9:16" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Padding="8,2"
                                            AutomationProperties.Name="{x:Bind views:Format.TileName('Play 16:9 export of', Title), Mode=OneWay}"
                                            Click="PlayHorizontal_Click"
                                            FontSize="12"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Play the exported 16:9 clip"
                                            Visibility="{x:Bind HasHorizontal, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon FontSize="12" Glyph="&#xE768;" />
                                                <TextBlock Text="16:9" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!--  Player  -->
            <Border
                Grid.Column="1"
                Padding="12"
                Style="{StaticResource PaneBorder}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <SelectorBar x:Name="PreviewBar" SelectionChanged="PreviewBar_SelectionChanged">
                        <SelectorBarItem
                            x:Name="EditTab"
                            AutomationProperties.Name="Preview edit"
                            IsSelected="True"
                            Text="Edit"
                            ToolTipService.ToolTip="The timeline as it will be exported" />
                        <SelectorBarItem
                            x:Name="SourceTab"
                            AutomationProperties.Name="Preview source"
                            Text="Source video"
                            ToolTipService.ToolTip="The whole video: mark a part to add it or make a new clip" />
                        <SelectorBarItem
                            x:Name="VerticalTab"
                            AutomationProperties.Name="Preview 9:16 export"
                            IsEnabled="{x:Bind ViewModel.Selected.HasVertical, Mode=OneWay, FallbackValue=False}"
                            Text="9:16 export" />
                        <SelectorBarItem
                            x:Name="HorizontalTab"
                            AutomationProperties.Name="Preview 16:9 export"
                            IsEnabled="{x:Bind ViewModel.Selected.HasHorizontal, Mode=OneWay, FallbackValue=False}"
                            Text="16:9 export" />
                    </SelectorBar>

                    <!--
                        Edit in 9:16: the source with the crop boxes that follow the people (left) and the vertical
                        frame they make, with captions (right). 16:9 and the other tabs: one screen.
                    -->
                    <Grid
                        x:Name="Stage"
                        Grid.Row="1"
                        ColumnSpacing="12"
                        SizeChanged="Stage_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            x:Name="SourceView"
                            Background="Black"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                            <MediaPlayerElement
                                x:Name="Player"
                                AreTransportControlsEnabled="False"
                                AutomationProperties.Name="Preview player"
                                Stretch="Uniform" />
                            <!--  Crop boxes over the source (9:16 Edit).  -->
                            <Canvas x:Name="BoxCanvas" IsHitTestVisible="False" />
                            <Border
                                x:Name="ShotChip"
                                Margin="8"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="#B3000000"
                                CornerRadius="4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="White"
                                    Text="{x:Bind ViewModel.ShotText, Mode=OneWay}" />
                            </Border>
                            <!--  Rough look of the burned-in title and captions (the export has the real style).  -->
                            <Grid x:Name="Overlay" IsHitTestVisible="False">
                                <Border
                                    x:Name="TitleOverlay"
                                    Margin="12,24,12,0"
                                    Padding="12,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Background="#CC000000"
                                    CornerRadius="4"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{x:Bind ViewModel.ClipTitle, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </Border>
                                <TextBlock
                                    x:Name="CaptionOverlay"
                                    Margin="24,32"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    HorizontalTextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </Grid>
                        <!--  Nothing open.  -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8"
                            Visibility="{x:Bind ViewModel.NoClip, Mode=OneWay}">
                            <FontIcon
                                FontSize="28"
                                Foreground="#99FFFFFF"
                                Glyph="&#xE714;" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="No clip open" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="#B3FFFFFF"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Pick a video above, or create clips first." />
                        </StackPanel>
                        </Grid>
                        <!--  The 9:16 frame: each panel is a cropped view of the source.  -->
                        <Grid
                            x:Name="Phone"
                            Grid.Column="1"
                            AutomationProperties.Name="Vertical preview"
                            Background="#0B0C10"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="Collapsed">
                            <Canvas x:Name="PhoneCanvas" />
                            <StackPanel
                                x:Name="FramingBusy"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsFramingBusy, Mode=OneWay}">
                                <ProgressRing IsActive="{x:Bind ViewModel.IsFramingBusy, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Foreground="#B3FFFFFF"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Finding the people…" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!--  Transport (Edit). Source and exports use the player's own controls.  -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="12"
                        Visibility="{x:Bind ViewModel.IsEditPreview, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Typography.NumeralAlignment="Tabular"
                            Text="{x:Bind ViewModel.PositionText, Mode=OneWay}"
                            TextWrapping="NoWrap" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                AutomationProperties.Name="Go to start"
                                Click="ToStart_Click"
                                Style="{StaticResource ToolButton}"
                                ToolTipService.ToolTip="Go to start (Home)">
                                <FontIcon FontSize="16" Glyph="&#xE892;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Back 1 second"
                                Click="Back_Click"
                                Style="{StaticResource ToolButton}"
                                ToolTipService.ToolTip="Back 1 s (←, Shift+← 5 s)">
                                <FontIcon FontSize="16" Glyph="&#xED3C;" />
                            </Button>
                            <Button
                                x:Name="PlayButton"
                                AutomationProperties.Name="Play"
                                Click="Play_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                ToolTipService.ToolTip="Play / pause (Space)">
                                <FontIcon
                                    x:Name="PlayGlyph"
                                    FontSize="14"
                                    Glyph="&#xE768;" />
                            </Button>
                            <Button
                                AutomationProperties.Name="Forward 1 second"
                                Click="Forward_Click"
                                Style="{StaticResource ToolButton}"
                                ToolTipService.ToolTip="Forward 1 s (→, Shift+→ 5 s)">
                                <FontIcon FontSize="16" Glyph="&#xED3D;" />
                            </Button>
                            <ToggleButton
                                x:Name="LoopToggle"
                                Padding="9,7"
                                AutomationProperties.Name="Loop"
                                ToolTipService.ToolTip="Loop playback">
                                <FontIcon FontSize="16" Glyph="&#xE8EE;" />
                            </ToggleButton>
                        </StackPanel>
                        <ComboBox
                            x:Name="PreviewSpeed"
                            Grid.Column="2"
                            MinWidth="80"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Preview speed"
                            SelectedIndex="1"
                            SelectionChanged="PreviewSpeed_SelectionChanged"
                            ToolTipService.ToolTip="Preview speed (the export uses Speed in Look)">
                            <x:String>0.5×</x:String>
                            <x:String>1×</x:String>
                            <x:String>1.5×</x:String>
                            <x:String>2×</x:String>
                        </ComboBox>
                    </Grid>

                    <!--  Source: mark a part of the whole video.  -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="12"
                        Visibility="{x:Bind ViewModel.IsSourcePreview, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button
                                AutomationProperties.Name="Mark in"
                                Command="{x:Bind ViewModel.SetMarkInCommand}"
                                Content="In"
                                ToolTipService.ToolTip="Mark the start of a part (I)" />
                            <Button
                                AutomationProperties.Name="Mark out"
                                Command="{x:Bind ViewModel.SetMarkOutCommand}"
                                Content="Out"
                                ToolTipService.ToolTip="Mark the end of a part (O)" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource HintText}"
                            Text="{x:Bind ViewModel.MarksText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Add marked part to timeline"
                            Command="{x:Bind ViewModel.AddMarkedCommand}"
                            ToolTipService.ToolTip="Add the marked part after the selected part">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE710;" />
                                <TextBlock Text="Add to timeline" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!--  Inspector: what this shot shows, its captions, the clip.  -->
            <Border
                Grid.Column="2"
                Style="{StaticResource PaneBorder}"
                Visibility="{x:Bind ViewModel.HasClip, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <SelectorBar
                        x:Name="InspectorBar"
                        Margin="8,4,8,0"
                        SelectionChanged="InspectorBar_SelectionChanged">
                        <SelectorBarItem
                            x:Name="LayoutTab"
                            IsSelected="True"
                            Text="Layout" />
                        <SelectorBarItem x:Name="CaptionsTab" Text="Captions" />
                        <SelectorBarItem x:Name="ClipTab" Text="Clip" />
                    </SelectorBar>
                    <ScrollViewer x:Name="InspectorScroll" Grid.Row="1">
                        <Grid Padding="16,8,16,16">
                            <!--  Layout  -->
                            <StackPanel x:Name="LayoutPanel" Spacing="16">
                                <RadioButtons
                                    AutomationProperties.Name="Format"
                                    Header="Format"
                                    MaxColumns="2"
                                    SelectedIndex="{x:Bind ViewModel.FormatIndex, Mode=TwoWay}">
                                    <x:String>Vertical 9:16</x:String>
                                    <x:String>Horizontal 16:9</x:String>
                                </RadioButtons>
                                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsVertical, Mode=OneWay}">
                                    <!--  The shot under the playhead: only what it can really show.  -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="This shot" />
                                        <TextBlock
                                            AutomationProperties.Name="Current shot"
                                            Style="{StaticResource HintText}"
                                            Text="{x:Bind ViewModel.ShotText, Mode=OneWay}" />
                                        <ItemsControl AutomationProperties.Name="Layouts for this shot" ItemsSource="{x:Bind ViewModel.ShotOptions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShotOption">
                                                    <ToggleButton
                                                        Margin="0,0,0,4"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        AutomationProperties.Name="{x:Bind Label}"
                                                        Click="ShotOption_Click"
                                                        Content="{x:Bind Label}"
                                                        IsChecked="{x:Bind IsCurrent}"
                                                        Tag="{x:Bind Id}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <HyperlinkButton
                                            Padding="0"
                                            AutomationProperties.Name="Back to automatic"
                                            Click="ShotAuto_Click"
                                            Content="Back to automatic"
                                            Visibility="{x:Bind ViewModel.ShotIsYours, Mode=OneWay}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        AutomationProperties.Name="Swap top and bottom"
                                        Header="Swap top and bottom"
                                        IsEnabled="{x:Bind ViewModel.CanSwap, Mode=OneWay}"
                                        IsOn="{x:Bind ViewModel.SwapStack, Mode=TwoWay}"
                                        ToolTipService.ToolTip="Put the face below the game, or the other person on top" />
                                    <ToggleSwitch
                                        AutomationProperties.Name="Smart zoom"
                                        Header="Smart zoom on strong lines"
                                        IsOn="{x:Bind ViewModel.SmartZoom, Mode=TwoWay}" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Framing"
                                        Header="Framing rules"
                                        ItemsSource="{x:Bind vm:EditorViewModel.Framings}"
                                        SelectedIndex="{x:Bind ViewModel.FramingIndex, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Captions  -->
                            <StackPanel
                                x:Name="CaptionsPanel"
                                Spacing="16"
                                Visibility="Collapsed">
                                <ToggleSwitch
                                    AutomationProperties.Name="Burn in captions"
                                    Header="Captions"
                                    IsOn="{x:Bind ViewModel.BurnCaptions, Mode=TwoWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Caption style"
                                    Header="Style"
                                    ItemsSource="{x:Bind ViewModel.CaptionStyles}"
                                    SelectedIndex="{x:Bind ViewModel.CaptionStyleIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:CaptionPreset">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Description}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <RadioButtons
                                    AutomationProperties.Name="Caption position"
                                    Header="Position"
                                    MaxColumns="2"
                                    SelectedIndex="{x:Bind ViewModel.CaptionPositionIndex, Mode=TwoWay}">
                                    <x:String>Auto (off the faces)</x:String>
                                    <x:String>Bottom</x:String>
                                    <x:String>Middle</x:String>
                                    <x:String>Top</x:String>
                                </RadioButtons>
                                <Slider
                                    AutomationProperties.Name="Caption size"
                                    Header="Size (%)"
                                    Maximum="160"
                                    Minimum="60"
                                    StepFrequency="5"
                                    Value="{x:Bind ViewModel.CaptionSize, Mode=TwoWay}" />
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Text" />
                                    <TextBlock Style="{StaticResource HintText}" Text="Fix misheard words. Word timing is kept; added or removed words share it." />
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Segments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:Segment">
                                                <TextBox
                                                    Margin="0,0,0,8"
                                                    AcceptsReturn="False"
                                                    AutomationProperties.Name="{x:Bind TextName, Mode=OneWay}"
                                                    Header="{x:Bind Label, Mode=OneWay}"
                                                    Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!--  Clip  -->
                            <StackPanel
                                x:Name="ClipPanel"
                                Spacing="16"
                                Visibility="Collapsed">
                                <TextBox
                                    AutomationProperties.Name="Clip title"
                                    Header="Title"
                                    MaxLength="120"
                                    Text="{x:Bind ViewModel.ClipTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Title at the top"
                                    Header="Show the title for the first seconds"
                                    IsOn="{x:Bind ViewModel.ShowTitle, Mode=TwoWay}" />
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="Export speed"
                                    Header="Speed"
                                    ItemsSource="{x:Bind vm:EditorViewModel.Speeds}"
                                    SelectedIndex="{x:Bind ViewModel.SpeedIndex, Mode=TwoWay}" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Cut dead air"
                                    Header="Cut pauses and filler words"
                                    IsOn="{x:Bind ViewModel.CutDeadAir, Mode=TwoWay}" />
                                <ToggleSwitch
                                    AutomationProperties.Name="Fade in and out"
                                    Header="Fade in and out"
                                    IsOn="{x:Bind ViewModel.Fade, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="Length" />
                                    <Run Text="{x:Bind ViewModel.LengthText, Mode=OneWay}" />
                                    <Run Text="in" />
                                    <Run Text="{x:Bind ViewModel.Segments.Count, Mode=OneWay}" />
                                    <Run Text="part(s), before speed and pause cuts." />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  Timeline  -->
        <Border
            Grid.Row="3"
            Padding="8,6,8,8"
            Style="{StaticResource PaneBorder}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button
                            AutomationProperties.Name="Undo"
                            Command="{x:Bind ViewModel.UndoCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon FontSize="16" Glyph="&#xE7A7;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Redo"
                            Command="{x:Bind ViewModel.RedoCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon FontSize="16" Glyph="&#xE7A6;" />
                        </Button>
                        <AppBarSeparator />
                        <Button
                            AutomationProperties.Name="Split at playhead"
                            Command="{x:Bind ViewModel.SplitCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Split at the playhead (S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE8C6;" />
                                <TextBlock Text="Split" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="Trim start to playhead"
                            Command="{x:Bind ViewModel.TrimStartCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Cut from the part's start to the playhead (Q)">
                            <FontIcon FontSize="16" Glyph="&#xE76B;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Trim end to playhead"
                            Command="{x:Bind ViewModel.TrimEndCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Cut from the playhead to the part's end (W)">
                            <FontIcon FontSize="16" Glyph="&#xE76C;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Delete part"
                            Command="{x:Bind ViewModel.DeleteSegmentCommand}"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Delete the selected part (Delete)">
                            <FontIcon FontSize="16" Glyph="&#xE74D;" />
                        </Button>
                        <AppBarSeparator />
                        <Button
                            x:Name="AddClipButton"
                            AutomationProperties.Name="Add a clip to the timeline"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Stitch another clip in after the selected part">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xECC8;" />
                                <TextBlock Text="Add clip" />
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout x:Name="AddClipMenu" Opening="AddClipMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="2">
                        <Button
                            AutomationProperties.Name="Zoom out"
                            Click="ZoomOut_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Zoom out (−, Ctrl+wheel)">
                            <FontIcon FontSize="16" Glyph="&#xE71F;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Fit timeline"
                            Click="Fit_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Fit the whole clip">
                            <FontIcon FontSize="16" Glyph="&#xE9A6;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Zoom in"
                            Click="ZoomIn_Click"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Zoom in (+, Ctrl+wheel)">
                            <FontIcon FontSize="16" Glyph="&#xE8A3;" />
                        </Button>
                        <Button
                            AutomationProperties.Name="Keyboard shortcuts"
                            Style="{StaticResource ToolButton}"
                            ToolTipService.ToolTip="Keyboard shortcuts">
                            <FontIcon FontSize="16" Glyph="&#xE765;" />
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock
                                        LineHeight="22"
                                        Style="{StaticResource BodyTextBlockStyle}"
                                        Text="Drag a part's edge to trim, or the part to move it&#x0a;Space  play / pause&#x0a;← →  1 s  (Shift: 5 s)   Home  start&#x0a;S  split   Q / W  trim to playhead&#x0a;Delete  delete part&#x0a;I / O  mark in / out (Source video)&#x0a;N  new clip&#x0a;Ctrl+Z / Ctrl+Y  undo / redo&#x0a;Ctrl+E  export   + / −  zoom" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
                <views:TimelineView
                    x:Name="Timeline"
                    Grid.Row="1"
                    Height="140" />
            </Grid>
        </Border>
    </Grid>
</Page>

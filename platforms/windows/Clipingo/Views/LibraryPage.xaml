<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Clipingo.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Clipingo.Views"
    xmlns:vm="using:Clipingo.ViewModels"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel
            Padding="{StaticResource PagePadding}"
            Spacing="24">
            <Grid>
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleText}"
                        Text="Library" />
                    <TextBlock Style="{StaticResource DescriptionText}" Text="Every video you clipped. Edit opens its clips in the editor." />
                </StackPanel>
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    AutomationProperties.Name="Refresh library"
                    Command="{x:Bind ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind views:Format.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />

            <Border
                Padding="32,56"
                Style="{StaticResource PanelBorder}"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <StackPanel HorizontalAlignment="Center" Spacing="4">
                    <FontIcon
                        FontSize="26"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE8F1;" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Nothing here yet" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource HintText}"
                        Text="Runs appear once Create has found moments in a video." />
                </StackPanel>
            </Border>

            <ItemsControl AutomationProperties.Name="Saved runs" ItemsSource="{x:Bind ViewModel.Runs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RunCard">
                        <Grid
                            Margin="0,0,0,8"
                            Padding="12"
                            Background="{ThemeResource GlassBrush}"
                            BorderBrush="{ThemeResource GlassEdgeBrush}"
                            BorderThickness="1"
                            ColumnSpacing="16"
                            CornerRadius="{StaticResource OverlayCornerRadius}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Height="72"
                                Background="Black"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Image Source="{x:Bind views:Format.File(Thumb), Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <TextBlock Style="{StaticResource HintText}" Text="{x:Bind Details}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    AutomationProperties.Name="{x:Bind views:Format.TileName('Edit clips of', Title)}"
                                    Click="Edit_Click"
                                    Tag="{x:Bind Run.Id}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                        <TextBlock Text="Edit" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Open folder"
                                    Click="{x:Bind OpenFolder}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTipService.ToolTip="Open the exported clips in File Explorer">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    AutomationProperties.Name="{x:Bind views:Format.TileName('Delete', Title)}"
                                    Click="Delete_Click"
                                    Style="{StaticResource GhostButton}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Remove from the Library (exported clips stay)">
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Clipingo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Clipingo.Views"
    Title="Clipingo">

    <Window.SystemBackdrop>
        <views:GrayBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Clipingo"
            Subtitle="Stream clipper">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!--  A newer release on GitHub (checked at start-up when automatic updates are on).  -->
        <InfoBar
            Grid.Row="1"
            Margin="12,0,12,8"
            IsClosable="True"
            IsOpen="{x:Bind Updates.IsAvailable, Mode=OneWay}"
            Message="{x:Bind Updates.AvailableText, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    AutomationProperties.Name="Update now"
                    Command="{x:Bind Updates.InstallCommand}"
                    Content="Update now" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView
            x:Name="Nav"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="232"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.Resources>
                <!--  The content area is the window itself, with glass panels on it.  -->
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="CreateItem"
                    AutomationProperties.Name="Create clips"
                    Content="Create"
                    Tag="Create">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8C6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    AutomationProperties.Name="Library"
                    Content="Library"
                    Tag="Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="EditorItem"
                    AutomationProperties.Name="Editor"
                    Content="Editor"
                    Tag="Editor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Name="JobsItem"
                    AutomationProperties.Name="Jobs"
                    Content="Jobs"
                    Tag="Jobs">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    AutomationProperties.Name="Settings"
                    Content="Settings"
                    Tag="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <!--  Pages start right beside the sidebar and stop growing at a readable width.  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PageColumn" Width="*" />
                    <ColumnDefinition Width="0" />
                </Grid.ColumnDefinitions>
                <Frame x:Name="ContentFrame" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
